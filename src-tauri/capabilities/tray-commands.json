{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "tray-commands",
  "description": "The application commands the tray popover may call, which is what TrayApp and the boot code in main.tsx reach. It covers the popover's own job (the routing switches, the certificate trust they can prompt for, closing and reopening tools, the security feed, the per-app messages, pin/unpin and handing off to the main window) and nothing that changes the account: no save_account, clear_account, switch_gateway, set_org, sign-in or sign-out, no proxy_disable, no launch-at-login or preference writes. Kept beside `tray`, which carries the popover's plugin permissions.",
  "windows": [
    "tray"
  ],
  "permissions": [
    "allow-activity-cached-tool-overviews",
    "allow-activity-installations",
    "allow-activity-overview",
    "allow-analytics-identity",
    "allow-analytics-milestone-claim",
    "allow-app-platform",
    "allow-close-running-agents",
    "allow-connect-tool",
    "allow-cowork-setting-check",
    "allow-disconnect-tool",
    "allow-drain-backend-errors",
    "allow-get-account",
    "allow-get-account-key-prefix",
    "allow-get-preferences",
    "allow-hermes-upstream-coverage",
    "allow-install-id",
    "allow-list-tools",
    "allow-log-message",
    "allow-os-name",
    "allow-pin-popover",
    "allow-proxy-enable",
    "allow-proxy-set-domain",
    "allow-proxy-set-env-export",
    "allow-proxy-status",
    "allow-proxy-trust-ca",
    "allow-proxy-untrust-ca",
    "allow-quit-app",
    "allow-read-auto-enabled-domains",
    "allow-record-auto-enabled-domains",
    "allow-reopen-running-agents",
    "allow-request-switch-org",
    "allow-reveal-popover",
    "allow-routing-startup-pending",
    "allow-routing-verdicts",
    "allow-running-agents",
    "allow-security-feed-history-ok",
    "allow-security-feed-recent",
    "allow-security-feed-retry",
    "allow-security-feed-state",
    "allow-set-analytics-identity",
    "allow-unpin-popover"
  ]
}
