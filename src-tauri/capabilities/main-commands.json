{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-commands",
  "description": "The application commands the main window may call: everything NewUiApp and the boot code in main.tsx reach, and nothing else. Commands only the tray or the intro window call (pin_popover, unpin_popover, reveal_popover, request_switch_org, routing_startup_pending, activity_cached_tool_overviews) are not here, and neither are the three nothing calls (tool_status, set_auth_mode, set_billing_mode). Plugin permissions stay on `default`. A command added to build.rs's APP_COMMANDS is refused in every window until a capability grants it; src/lib/capabilities.test.ts fails if a window's code reaches a command its capability does not grant.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-activity-cached-overview",
    "allow-activity-installations",
    "allow-activity-overview",
    "allow-activity-tool-events",
    "allow-analytics-identity",
    "allow-analytics-milestone-claim",
    "allow-app-platform",
    "allow-clear-account",
    "allow-close-running-agents",
    "allow-connect-tool",
    "allow-cowork-setting-check",
    "allow-device-name",
    "allow-diagnostics",
    "allow-disconnect-tool",
    "allow-drain-backend-errors",
    "allow-gate-credits",
    "allow-gate-model-catalogue",
    "allow-get-account",
    "allow-get-account-key-prefix",
    "allow-get-preferences",
    "allow-hermes-upstream-coverage",
    "allow-install-id",
    "allow-launch-at-login-status",
    "allow-list-providers",
    "allow-list-tools",
    "allow-log-message",
    "allow-oauth-begin-login",
    "allow-oauth-cancel-login",
    "allow-oauth-list-orgs",
    "allow-oauth-sign-out",
    "allow-oauth-status",
    "allow-open-onboarding-window",
    "allow-os-name",
    "allow-proxy-browser-store",
    "allow-proxy-disable",
    "allow-proxy-enable",
    "allow-proxy-set-domain",
    "allow-proxy-set-env-export",
    "allow-proxy-status",
    "allow-proxy-trust-ca",
    "allow-proxy-untrust-ca",
    "allow-quit-app",
    "allow-read-auto-enabled-domains",
    "allow-record-auto-enabled-domains",
    "allow-reopen-running-agents",
    "allow-routed-clients-stale",
    "allow-routing-verdicts",
    "allow-running-agents",
    "allow-save-account",
    "allow-security-feed-history-ok",
    "allow-security-feed-recent",
    "allow-security-feed-retry",
    "allow-security-feed-state",
    "allow-set-analytics-identity",
    "allow-set-device-name",
    "allow-set-launch-at-login",
    "allow-set-notifications",
    "allow-set-org",
    "allow-set-security-notification-sound",
    "allow-set-share-diagnostics",
    "allow-set-tool-model",
    "allow-set-updater-relaunching",
    "allow-switch-gateway",
    "allow-teardown-report",
    "allow-tool-model-preferences",
    "allow-tool-versions"
  ]
}
